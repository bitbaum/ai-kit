{
  "name": "@bitbaum/ai-kit",
  "version": "1.4.1",
  "license": "MIT",
  "author": "Mao Nakamoto",
  "homepage": "https://github.com/bitbaum/ai-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbaum/ai-kit.git"
  },
  "bugs": {
    "url": "https://github.com/bitbaum/ai-kit/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "form-fill",
    "fallback",
    "failover",
    "health-check",
    "free-tier",
    "rate-limit",
    "quota",
    "fair-share",
    "groq",
    "openrouter"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "dist-cjs",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "default": "./dist/forms.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "require": "./dist-cjs/registry.js",
      "default": "./dist/registry.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./capability": {
      "types": "./dist/capability/index.d.ts",
      "default": "./dist/capability/index.js"
    },
    "./grounding": {
      "types": "./dist/grounding/index.d.ts",
      "require": "./dist-cjs/grounding/index.js",
      "default": "./dist/grounding/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist-cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "check:catalog": "pnpm run build && node scripts/check-catalog.mjs",
    "smoke": "pnpm run build && node scripts/smoke.mjs",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test",
    "prepare": "pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "ai-forms": "^0.1.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
